# Copy to .env. Never commit .env (it's in .gitignore).

# --- MySQL: the same database as the API -------------------------------------------
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USER=spotter
DATABASE_PASSWORD=
DATABASE=spotter
DATABASE_POOL_SIZE=5

# --- Reminders -----------------------------------------------------------------------
# Time zone for users who haven't saved one (users.timezone is NULL). Defaults to the server's zone.
REMINDER_DEFAULT_TIMEZONE=Europe/Oslo
# How long after its time a reminder may still be sent (catch-up after a restart). 5–120.
REMINDER_GRACE_MINUTES=30
# How often to check for due reminders (UTC cron syntax). Keep this shorter than the grace period.
SCHEDULE_TICK_CRON=*/5 * * * *
# Push receipts check and reminderLog cleanup.
SCHEDULE_MAINTENANCE_CRON=*/15 * * * *
RECEIPT_DELAY_MINUTES=15
REMINDER_LOG_RETENTION_DAYS=60

# --- Expo ----------------------------------------------------------------------------
# Only needed if "Enhanced push security" is enabled for the Expo project.
EXPO_ACCESS_TOKEN=

# --- Operations ----------------------------------------------------------------------
# Serve GET /health on this port (0 or empty = off).
HEALTH_PORT=
# debug | info | warn | error | silent
LOG_LEVEL=info
# true = log what would be sent without sending (same as --dry-run)
DRY_RUN=false
