{
  "name": "spotter-schedule",
  "version": "2.0.0",
  "description": "Spotter background worker: time-zone-aware workout, step, meal, calorie and workout-partner push reminders.",
  "private": true,
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "once": "node server.js --once",
    "dry-run": "node server.js --once --dry-run",
    "test": "node --test \"test/*.test.js\"",
    "lint": "eslint .",
    "typecheck": "tsc -p jsconfig.json",
    "check": "npm run lint && npm run typecheck && npm test"
  },
  "license": "ISC",
  "dependencies": {
    "cron": "^4.3.3",
    "dotenv": "^16.4.7",
    "expo-server-sdk": "^3.15.0",
    "luxon": "^3.7.2",
    "mysql2": "^3.24.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/luxon": "^3.6.2",
    "@types/node": "^22.0.0",
    "eslint": "^9.39.0",
    "globals": "^16.0.0",
    "typescript": "~6.0.3"
  }
}
